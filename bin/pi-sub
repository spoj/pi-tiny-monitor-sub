#!/bin/sh
# Runs pi with the calling Pi session recorded as parentSession.
[ -n "$PI_SESSION_FILE" ] || exec pi "$@"
json() { printf '%s' "$1" | sed 's/[\\"]/\\&/g'; }
id=$(uuidgen | tr A-Z a-z)
ts=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
file="$(dirname "$PI_SESSION_FILE")/$(echo "$ts" | tr :. --)_$id.jsonl"
# Pi matches sessions by its physical cwd, so record pwd -P rather than a symlinked $PWD.
printf '{"type":"session","version":3,"id":"%s","timestamp":"%s","cwd":"%s","parentSession":"%s"}\n' \
	"$id" "$ts" "$(json "$(pwd -P)")" "$(json "$PI_SESSION_FILE")" > "$file"
exec pi --session "$file" "$@"
